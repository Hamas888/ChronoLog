{
  "name": "ChronoLog",
  "version": "1.2.0",
  "description": "Cross-platform real-time logger for embedded systems and desktop. Features thread safety, progress bars, profiling, and colorized output for Linux, Windows, macOS, and Arduino (AVR/ESP32/STM32/nRF52).",
  "keywords": [
    "logger",
    "logging",
    "debug",
    "serial",
    "uart",
    "printf",
    "rtos",
    "thread-safe",
    "profiling",
    "progress-bar",
    "embedded",
    "esp32",
    "stm32",
    "nrf52",
    "arduino",
    "avr",
    "platformio",
    "chrono",
    "chronolog"
  ],
  "authors": [
    {
      "name": "Hamas Saeed",
      "email": "hamasaeed888@gmail.com",
      "url": "https://github.com/Hamas888",
      "maintainer": true
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Hamas888/ChronoLog.git"
  },
  "frameworks": ["arduino", "espidf"],
  "platforms": ["atmelavr","espressif32", "ststm32", "nordicnrf52"],
  "build": {
    "flags": [
      "-std=gnu++17"
    ],
    "unflags": [
      "-std=gnu++11"
    ]
  },
  "license": "MIT",
  "homepage": "https://github.com/Hamas888/ChronoLog",
  "examples": [
    "examples/ESP/PlatformIO/platformio.ini",
    "examples/Desktop/CMakeLists.txt"
  ],
  "export": {
    "include": [
      "src",
      "include",
      "zephyr",
      "Kconfig",
      "CMakeLists.txt",
      "library.json",
      "library.properties",
      "LICENSE",
      "README.md"
    ],
    "exclude": [
      "test",
      ".pio",
      ".vscode"
    ]
  }
}